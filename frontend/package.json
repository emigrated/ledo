{
  "name": "registration-frontend",
  "version": "1.0.17",
  "description": "Ledo Registration System Web Application",
  "author": "Ledo Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.ledo.registration",
    "productName": "企业内部系统",
    "asar": false,
    "electronVersion": "37.3.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "publish": {
      "provider": "generic",
      "url": "https://emigrated.i234.me:3443/api/updates"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "semver": "^7.7.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.3",
    "vite": "^5.0.11"
  },
  "publish": {
    "provider": "generic",
    "url": "https://emigrated.i234.me:3443/api/updates"
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
